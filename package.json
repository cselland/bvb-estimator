{
  "name": "build-vs-buy",
  "version": "0.1.0",
  "private": true,
  "description": "Build-vs-buy workspace: Next.js TCO app (repo root) and Harry analyst Worker (./harry).",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "harry:dev": "npm --prefix harry run dev",
    "harry:typecheck": "npm --prefix harry run typecheck",
    "harry:deploy": "npm --prefix harry run deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "next": "^14.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
