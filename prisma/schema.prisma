generator client {
  provider      = "prisma-client-js"
  // Linux engine variant is chosen at runtime; include both OpenSSL flavors for Cloudflare + local macOS.
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Scenario {
  id                String   @id @default(cuid()) @map("_id")
  sessionId         String
  email             String?
  payloadJson       String
  summaryMarkdown   String
  verdict           String
  buildThreeYearTco Float
  saasThreeYearTco  Float
  createdAt         DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}
