# Scenarios are stored in Cloudflare D1 (binding `DB`). Plain `next dev` has no D1 — use `pnpm run dev:cf`
# for local saves/reports, or hit the deployed Worker.

# Optional: AI summary generation by "Harry"
# If provider credentials are missing, summaries fall back to deterministic template output.
#
# Provider switch: gemini (default) | openai | claude | custom
# SUMMARY_PROVIDER="gemini"
#
# Gemini (default via OpenAI-compatible API)
# GEMINI_API_KEY="<your-gemini-api-key>"
# OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# OPENAI_MODEL="gemini-2.5-flash"
#
# OpenAI
# OPENAI_API_KEY="<your-openai-api-key>"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"
#
# Claude
# SUMMARY_PROVIDER="claude"
# ANTHROPIC_API_KEY="<your-anthropic-api-key>"
# ANTHROPIC_MODEL="claude-3-5-sonnet-latest"
#
# Custom endpoint (expects POST JSON and returns markdown/content/summary field)
# SUMMARY_PROVIDER="custom"
# CUSTOM_SUMMARY_URL="https://your-domain.com/api/summary"
# CUSTOM_SUMMARY_API_KEY="<optional-bearer-token>"

# Optional: send summary & share emails via Resend (https://resend.com)
# Local `pnpm run dev`: set both in .env
# Production (Cloudflare Worker):
#   - RESEND_API_KEY → Worker secret: `pnpm exec wrangler secret put RESEND_API_KEY`
#   - RESEND_FROM → already in wrangler.toml (must use a domain verified in Resend)
# RESEND_API_KEY="re_xxxxxxxxx"
# RESEND_FROM="Build vs Buy <reports@yourdomain.com>"
